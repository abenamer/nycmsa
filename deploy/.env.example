# Copy to .env on the server. cloud-init does this for you.
# Letters and digits only: the value goes into a URL unescaped. cloud-init
# generates a 48-character hex one.
POSTGRES_PASSWORD=change-me
# ":80" until you have a DNS name pointing at the server; then the name.
SITE_ADDRESS=:80
# Pin a specific build instead of the newest: NYCMSA_IMAGE=ghcr.io/abenamer/nycmsa:sha-abc1234
